{
  "Flow": {
    "prefix": "flow",
    "body": [
      "flow ${1:Main}(${2}) -> ${3:any} {",
      "  return ${0:null}",
      "}"
    ],
    "description": "Named Flow with a result"
  },
  "Void Flow": {
    "prefix": "flowvoid",
    "body": [
      "flow ${1:Main}(${2}) -> void {",
      "  $0",
      "}"
    ],
    "description": "Flow without a result"
  },
  "Pure function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:value}: ${3:number}) -> ${4:number} {",
      "  ${0:value}",
      "}"
    ],
    "description": "Pure function; final expression is its result"
  },
  "Anonymous function": {
    "prefix": "lambda",
    "body": "fn (${1:x}: ${2:number}) -> ${3:number} { ${0:x} }",
    "description": "Pure anonymous function"
  },
  "If else": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "  $2",
      "} else {",
      "  $0",
      "}"
    ],
    "description": "Conditional statement or value expression"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "  ${2:null} => ${3:0},",
      "  _ => ${0:1}",
      "}"
    ],
    "description": "Match expression with fallback"
  },
  "Sequential loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "  $0",
      "}"
    ],
    "description": "Sequential iteration"
  },
  "Parallel Claim": {
    "prefix": "claimfor",
    "body": [
      "${1:results} = claim()",
      "for ${2:item} in ${3:items} parallel {",
      "  $1 <+ ${0:item}",
      "}"
    ],
    "description": "Append facts in a parallel loop"
  },
  "Carry iteration": {
    "prefix": "carry",
    "body": [
      "${1:total} = for ${2:item} in ${3:items} with ${4:acc} = ${5:0} {",
      "  next ${0:acc + item}",
      "}"
    ],
    "description": "Iteration carrying an immutable value"
  },
  "Comprehension": {
    "prefix": "comp",
    "body": "[${1:item} for ${2:item} in ${3:items} if ${0:true}]",
    "description": "List comprehension with a guard"
  },
  "LIP import": {
    "prefix": "importlip",
    "body": "import lip \"${1:lib/module.lip}\" as ${0:module}",
    "description": "Static LIP module import"
  },
  "Python import": {
    "prefix": "importpy",
    "body": "import python \"${1:math}\" as ${0:math}",
    "description": "Python module import"
  },
  "Go import": {
    "prefix": "importgo",
    "body": "import go \"${1:strings}\" as ${0:strings}",
    "description": "Go package import"
  },
  "Host import": {
    "prefix": "importhost",
    "body": "import host \"${1:service}\" as ${0:service}",
    "description": "Registered Host path; contract version is provided by the Host registry"
  },
  "Perform": {
    "prefix": "perform",
    "body": "${1:result} = perform effect ${2:module}.${3:operation}(${0})",
    "description": "Construct and execute an external operation proposal"
  },
  "Perform proposal": {
    "prefix": "performproposal",
    "body": "${1:result} = perform ${0:proposal}",
    "description": "Execute an existing proposal"
  },
  "Proposal": {
    "prefix": "effect",
    "body": "${1:proposal} = effect ${2:module}.${3:operation}(${0})",
    "description": "Construct a proposal without executing it"
  },
  "Pipeline": {
    "prefix": "pipe",
    "body": "${1:value} |> ${2:stage}(${0})",
    "description": "Static pipeline stage; input is its first argument"
  },
  "Multiline string": {
    "prefix": "text",
    "body": [
      "\"\"\"",
      "$0",
      "\"\"\""
    ],
    "description": "Multiline string; indentation is part of its value"
  },
  "Slice": {
    "prefix": "slice",
    "body": "${1:items}[${2:0}:${3:null}:${4:1}]$0",
    "description": "Half-open list/string slice; null omits a bound, step can be negative"
  },
  "Reverse": {
    "prefix": "reverse",
    "body": "${1:items}[::-1]$0",
    "description": "Reverse a list or Unicode scalar string"
  },
  "Index list": {
    "prefix": "indices",
    "body": "${1:items}[[${2:0}, ${3:-1}]]$0",
    "description": "Select list elements in order, preserving duplicates and allowing negative indices"
  },
  "Claim snapshot": {
    "prefix": "snapshot",
    "body": "${1:seen} = perform effect claim.snapshot(\"${2:facts}\")$0",
    "description": "Observe currently committed facts in a top-level Claim store of this Flow; does not wait for future writers"
  },
  "Native Data snapshot": {
    "prefix": "nativedata",
    "body": "${1:snapshot} = native_data(${0:resource})",
    "description": "Effectful native Host helper; obtain a finite, acyclic Data snapshot"
  },
  "Release native reference": {
    "prefix": "nativerelease",
    "body": "native_release(${0:resource})",
    "description": "Effectful native Host helper; release a reference after explicit business cleanup"
  },
  "Export static data": {
    "prefix": "exportdata",
    "body": "export ${1:answer}: ${2:number} = ${0:42}",
    "description": "Export a typed static Data literal from a declaration module"
  }
}
