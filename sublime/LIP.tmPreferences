<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>name</key><string>LIP comments and indentation</string>
  <key>scope</key><string>source.lip</string>
  <key>settings</key><dict>
    <key>shellVariables</key><array><dict>
      <key>name</key><string>TM_COMMENT_START</string>
      <key>value</key><string># </string>
    </dict></array>
    <key>increaseIndentPattern</key><string>^\s*[^#]*[\{\[(]\s*(?:#.*)?$</string>
    <key>decreaseIndentPattern</key><string>^\s*[}\])]</string>
  </dict>
</dict></plist>
