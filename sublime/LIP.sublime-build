{
  "cmd": ["lipcheck", "$file"],
  "working_dir": "$file_path",
  "selector": "source.lip",
  "file_regex": "^(.+):([0-9]+):([0-9]+): (.*)$",
  "variants": [
    {"name": "Run", "cmd": ["lipc", "run", "$file"]},
    {"name": "Build executable", "cmd": ["lipc", "build", "-o", "$file.out", "$file"]}
  ]
}
